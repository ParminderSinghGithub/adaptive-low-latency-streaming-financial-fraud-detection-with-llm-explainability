# Project specific ignores
# Raw datasets and zip archives
datasets/**/*.zip
datasets/**/*.csv
# Except we want to keep the directory structure of datasets if needed
!datasets/**/

# Local logs and output artifacts
logs/*.log
outputs/checkpoints/**/*.pt
outputs/checkpoints/**/*.pth
outputs/checkpoints/**/*.joblib
outputs/checkpoints/**/*.json
outputs/checkpoints/*.json
outputs/figures/**/*.png
outputs/figures/**/*.jpg
outputs/figures/**/*.pdf
outputs/tables/**/*.csv
outputs/tables/**/*.tex
outputs/metrics/**/*.json

# internal docs
docs/internal

# Kaggle artifacts and downloaded run archives (not source controlled)
kaggle_artifacts/*
!kaggle_artifacts/.gitkeep
!kaggle_artifacts/README.md
*.tar.gz